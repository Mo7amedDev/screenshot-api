{
  "name": "screenshot-api",
  "version": "1.0.0",
  "description": "Scalable screenshot rendering API using Fastify + Playwright + Satori",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "node --max-old-space-size=2048 dist/server.js",
    "start:cluster": "node dist/cluster.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "postbuild": "cp -r src/services/fonts dist/services/fonts",
    "install:browsers": "npx playwright install chromium --with-deps",
    "setup": "npm install && npm run install:browsers",
    "docker:build": "docker build -t screenshot-api .",
    "docker:run": "docker run -p 3000:3000 --rm screenshot-api"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "generic-pool": "^3.9.0",
    "html-react-parser": "^4.2.10",
    "playwright": "^1.64.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/sharp": "^0.31.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
